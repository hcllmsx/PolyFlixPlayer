<?xml version="1.0" encoding="utf-8"?>
<!--
    自适应图标「背景层」。
    颜色取自应用 logo 自身的蓝紫渐变（左 #0E3FE7 → 右 #8941E4），
    必须与 res/drawable-*/ic_launcher_foreground.png 搭配使用。
    由于没有适配自适应图标时，Android 8.0+ 的桌面会把旧式 PNG 缩小后
    垫在白色底板上（表现为「四周白边、中间图标」），这里用同色系背景层
    铺满整个图标格子，彻底消除白边。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="0"
        android:startColor="#0E3FE7"
        android:centerColor="#4B36EE"
        android:endColor="#8941E4" />
</shape>
